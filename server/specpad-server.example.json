{
  "projects": [
    {
      "id": "acme",
      "title": "Acme Infusion Pump",
      "url": "git@git.corp.internal:product/acme.git",
      "branch": "main",
      "credentialFile": "/run/secrets/specpad-acme-key",
      "paths": ["docs/specpad/"]
    },
    {
      "id": "beacon",
      "title": "Beacon Monitor",
      "url": "git@git.corp.internal:product/beacon.git",
      "branch": "main",
      "credentialFile": "/run/secrets/specpad-beacon-key",
      "paths": ["docs/specpad/"],
      "roles": {
        "committer": ["grp-beacon-quality"],
        "reader": ["grp-all-staff"]
      },
      "commit": {
        "requireGovernanceClean": "block"
      }
    }
  ],
  "auth": {
    "provider": "proxy",
    "trustedPeers": ["10.0.0.0/8"],
    "headers": {
      "user": "x-forwarded-user",
      "email": "x-forwarded-email",
      "name": "x-forwarded-preferred-username",
      "groups": "x-forwarded-groups"
    },
    "roles": {
      "committer": ["grp-product-managers", "grp-quality"],
      "editor": ["grp-engineering"],
      "reader": ["grp-all-staff"]
    }
  },
  "commit": {
    "requireActiveJob": true,
    "requireGovernanceClean": "warn",
    "pushRetries": 3
  },
  "workingCopies": {
    "idleTimeout": 86400,
    "sweepInterval": 3600
  },
  "workDir": "/srv/specpad",
  "port": 8080,
  "bind": "0.0.0.0"
}
